[
  {
    "name": "Run job",
    "fun": "run_job",
    "json_schema": {
      "title": "Run job",
      "type": "object",
      "required": [
        "tgt",
        "tgt_type",
        "fun",
        "salt_master"
      ],
      "properties": {
        "salt_master": {
          "title": "Salt master",
          "type": "string"
        },
        "tgt": {
          "title": "Salt target",
          "type": "string",
          "default": "*"
        },
        "target_type": {
          "title": "Salt target type",
          "type": "string",
          "enum": [
            "glob",
            "pcre",
            "list",
            "grain",
            "grain_pcre",
            "pillar",
            "pillar_pcre",
            "nodegroup",
            "range",
            "compound",
            "ipcidr"
          ],
          "default": "glob"
        },
        "fun": {
          "title": "Salt function",
          "type": "string"
        },
        "args": {
          "title": "Args",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kwargs": {
          "title": "Kwargs",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    },
    "ui_schema": {}
  },
  {
    "name": "Run task",
    "fun": "run_task",
    "json_schema": {},
    "ui_schema": {}
  }
]
