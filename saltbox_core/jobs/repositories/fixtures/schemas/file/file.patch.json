{
  "json_schema": {
    "type": "object",
    "title": "file.patch",
    "description": "Apply a patch to a file or directory",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "originalfile",
          "patchfile"
        ],
        "properties": {
          "originalfile": {
            "type": "string",
            "pattern": "^(?!.*?\\\\\\\\)(?!.*?\\/\\/)(?!.*\\\\.*\\/)(?!.*\\/.*\\\\)(?:[a-zA-Z]:\\\\|\\/)[^<>:,\"|?*\\0\\r\\n]+$"
          },
          "patchfile": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "default": [
              ""
            ],
            "items": {
              "type": "string",
              "title": "patch option"
            }
          },
          "dry_run": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "originalfile": {
        "ui:title": "Original file",
        "ui:description": "The full path to the file or directory to be patched"
      },
      "patchfile": {
        "ui:title": "Patch file",
        "ui:description": "A patch file to apply to originalfile"
      },
      "options": {
        "ui:title": "Options",
        "ui:description": "Options to pass to patch"
      },
      "dry_run": {
        "ui:title": "Dry run",
        "ui:description": "Preview the patch without changing any files",
        "ui:widget": "select"
      }
    }
  }
}
