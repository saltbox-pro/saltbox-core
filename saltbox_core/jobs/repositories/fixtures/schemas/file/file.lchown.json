{
  "json_schema": {
    "type": "object",
    "title": "file.lchown",
    "description": "Chown a file, pass the file the desired user and group without following symlinks",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "path",
          "user",
          "group"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*?\\\\\\\\)(?!.*?\\/\\/)(?!.*\\\\.*\\/)(?!.*\\/.*\\\\)(?:[a-zA-Z]:\\\\|\\/)[^<>:,\"|?*\\0\\r\\n]+$"
          },
          "user": {
            "type": "string"
          },
          "group": {
            "type": "string"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "path": {
        "ui:title": "Path",
        "ui:description": "Path to the file or directory"
      },
      "user": {
        "ui:title": "User",
        "ui:description": "User owner"
      },
      "group": {
        "ui:title": "Group",
        "ui:description": "Group owner"
      }
    }
  }
}
