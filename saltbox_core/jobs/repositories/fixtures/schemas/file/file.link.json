{
  "json_schema": {
    "type": "object",
    "title": "file.link",
    "description": "Create a hard link to a file",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "src",
          "path"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!.*?\\\\\\\\)(?!.*?\\/\\/)(?!.*\\\\.*\\/)(?!.*\\/.*\\\\)(?:[a-zA-Z]:\\\\|\\/)[^<>:,\"|?*\\0\\r\\n]+$"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "src": {
        "ui:title": "Source of file",
        "ui:description": ""
      },
      "path": {
        "ui:title": "Path of link",
        "ui:description": ""
      }
    }
  }
}
