{
  "json_schema": {
    "type": "object",
    "title": "file.stats",
    "description": "Return a dict containing the stats for a given file",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*?\\\\\\\\)(?!.*?\\/\\/)(?!.*\\\\.*\\/)(?!.*\\/.*\\\\)(?:[a-zA-Z]:\\\\|\\/)[^<>:,\"|?*\\0\\r\\n]+$"
          },
          "hash_type": {
            "type": "string",
            "oneOf": [
              {
                "title": "Blake2B",
                "const": "blake2b"
              },
              {
                "title": "Blake2S",
                "const": "blake2s"
              },
              {
                "title": "MD5",
                "const": "md5"
              },
              {
                "title": "SHA1",
                "const": "sha1"
              },
              {
                "title": "SHA224",
                "const": "sha224"
              },
              {
                "title": "SHA256",
                "const": "sha256"
              },
              {
                "title": "SHA384",
                "const": "sha384"
              },
              {
                "title": "SHA3-224",
                "const": "sha3_224"
              },
              {
                "title": "SHA3-256",
                "const": "sha3_256"
              },
              {
                "title": "SHA3-384",
                "const": "sha3_384"
              },
              {
                "title": "SHA3-512",
                "const": "sha3_512"
              },
              {
                "title": "SHA512",
                "const": "sha512"
              }
            ]
          },
          "follow_symlinks": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "path": {
        "ui:title": "Path to the file"
      },
      "hash_type": {
        "ui:title": "HASH Type",
        "ui:widget": "select"
      },
      "follow_symlinks": {
        "ui:title": "Follow the symbolic links",
        "ui:widget": "select"
      }
    }
  }
}
