{
  "json_schema": {
    "type": "object",
    "title": "user.add",
    "description": "Add a user to the minion",
    "additionalProperties": false,
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "Keyword arguments",
        "description": "",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$",
            "minLength": 3,
            "maxLength": 15
          },
          "uid": {
            "type": "integer",
            "minimum": 1
          },
          "gid": {
            "type": "integer",
            "minimum": 1
          },
          "groups": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]{2,32}(?:,[a-zA-Z][\\w\\.-]{2,32})*$"
          },
          "home": {
            "type": "string",
            "pattern": "^\\/[\\w-]+(?:\\/[\\w-]+)*$"
          },
          "shell": {
            "type": "string",
            "pattern": "^\\/[\\w-]+(?:\\/[\\w-]+)*$"
          },
          "unique": {
            "type": "boolean",
            "default": true
          },
          "system": {
            "type": "boolean",
            "default": false
          },
          "fullname": {
            "type": "string"
          },
          "roomnumber": {
            "type": "integer",
            "minimum": 1
          },
          "workphone": {
            "type": "string",
            "minLength": 11,
            "maxLength": 12
          },
          "homephone": {
            "type": "string",
            "minLength": 11,
            "maxLength": 12
          },
          "other": {
            "type": "string"
          },
          "createhome": {
            "type": "boolean",
            "default": true
          },
          "loginclass": {
            "type": "string",
            "pattern": "^\\S+$"
          },
          "nologinit": {
            "type": "boolean",
            "default": false
          },
          "root": {
            "type": "string",
            "pattern": "^\\/[\\w-]+(?:\\/[\\w-]+)*$"
          },
          "usergroup": {
            "type": "boolean",
            "default": true
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "ui:order": [
        "name",
        "fullname",
        "home",
        "shell",
        "groups",
        "workphone",
        "usergroup",
        "createhome",
        "system",
        "uid",
        "gid",
        "*"
      ],
      "name": {
        "ui:title": "Username",
        "ui:description": "Username LOGIN to add",
        "ui:autofocus": true
      },
      "uid": {
        "ui:title": "User ID",
        "ui:description": "User ID of the new account"
      },
      "gid": {
        "ui:title": "Group ID",
        "ui:description": "Name or ID of the primary group of the new account"
      },
      "groups": {
        "ui:title": "Groups",
        "ui:description": "List of supplementary groups of the new account (separated by commas)"
      },
      "home": {
        "ui:title": "Path to home directory",
        "ui:description": "Home directory of the new account"
      },
      "shell": {
        "ui:title": "Path to login shell",
        "ui:description": "Login shell of the new account"
      },
      "unique": {
        "ui:title": "Unique user ID",
        "ui:description": "If not True, the user account can have a non-unique UID",
        "ui:widget": "select"
      },
      "system": {
        "ui:title": "System account",
        "ui:description": "Create a system account",
        "ui:widget": "select"
      },
      "fullname": {
        "ui:title": "Full name",
        "ui:description": "GECOS field for the full name"
      },
      "roomnumber": {
        "ui:title": "Room number",
        "ui:description": "GECOS field for the room number"
      },
      "workphone": {
        "ui:title": "Work phone number",
        "ui:description": "GECOS field for the work phone"
      },
      "homephone": {
        "ui:title": "Home phone number",
        "ui:description": "GECOS field for the home phone"
      },
      "other": {
        "ui:title": "Other information",
        "ui:description": "GECOS field for other information"
      },
      "createhome": {
        "ui:title": "Create a home directory",
        "ui:description": "Create the user's home directory",
        "ui:widget": "select"
      },
      "loginclass": {
        "ui:title": "Login class",
        "ui:description": "Login class for the new account (OpenBSD)"
      },
      "nologinit": {
        "ui:title": "Do not log the user's last login",
        "ui:description": "Do not add the user to the lastlog and faillog databases",
        "ui:widget": "select"
      },
      "root": {
        "ui:title": "Path to root directory",
        "ui:description": "Directory to chroot into"
      },
      "usergroup": {
        "ui:title": "Create a primary group",
        "ui:description": "Create and add the user to a new primary group of the same username",
        "ui:widget": "select"
      }
    }
  }
}
