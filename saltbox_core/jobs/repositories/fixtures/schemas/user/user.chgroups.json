{
  "json_schema": {
    "type": "object",
    "title": "user.chgroups",
    "description": "Change the groups to which this user belongs",
    "additionalProperties": false,
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "Keyword arguments",
        "description": "",
        "additionalProperties": false,
        "required": [
          "name",
          "groups"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$",
            "minLength": 3,
            "maxLength": 15
          },
          "groups": {
            "type": "string",
            "pattern": "^[\\w\\.-]{3,15}(,[\\w\\.-]{3,15})*$"
          },
          "append": {
            "type": "boolean",
            "default": false
          },
          "root": {
            "type": "string"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "name": {
        "ui:title": "Username",
        "ui:description": "User to modify"
      },
      "groups": {
        "ui:title": "Groups",
        "ui:description": "Groups to set for the user (separated by commas)"
      },
      "append": {
        "ui:title": "Append groups",
        "ui:description": "If True, append the specified groups. Otherwise, this function will replace the user's groups with the specified group(s)",
        "ui:widget": "select"
      },
      "root": {
        "ui:title": "Path to root directory",
        "ui:description": "Directory to chroot into"
      }
    }
  }
}
