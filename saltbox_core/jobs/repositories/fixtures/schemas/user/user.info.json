{
  "json_schema": {
    "type": "object",
    "title": "user.info",
    "description": "Return user information",
    "additionalProperties": false,
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$",
            "minLength": 3,
            "maxLength": 15
          },
          "root": {
            "type": "string",
            "pattern": "^\\/[\\w-]+(?:\\/[\\w-]+)*$"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "name": {
        "ui:title": "Username",
        "ui:description": "User to get the information"
      },
      "root": {
        "ui:title": "Path to root directory",
        "ui:description": "Directory to chroot into"
      }
    }
  }
}
