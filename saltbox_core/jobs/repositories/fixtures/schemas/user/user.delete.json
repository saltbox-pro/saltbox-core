{
  "json_schema": {
    "type": "object",
    "title": "user.delete",
    "description": "Remove a user from the minion",
    "additionalProperties": false,
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "Keyword arguments",
        "description": "",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$",
            "minLength": 3,
            "maxLength": 15
          },
          "remove": {
            "type": "boolean",
            "default": false
          },
          "force": {
            "type": "boolean",
            "default": false
          },
          "root": {
            "type": "string",
            "pattern": "^\\/[\\w-]+(?:\\/[\\w-]+)*$"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "name": {
        "ui:title": "Username",
        "ui:description": "Username to delete"
      },
      "remove": {
        "ui:title": "Delete user files",
        "ui:description": "Remove home directory and mail spool",
        "ui:widget": "select"
      },
      "force": {
        "ui:title": "Force delete",
        "ui:description": "Force some actions that would fail otherwise",
        "ui:widget": "select"
      },
      "root": {
        "ui:title": "Path to root directory",
        "ui:description": "Directory to chroot into"
      }
    }
  }
}
