{
  "json_schema": {
    "type": "object",
    "title": "ansible.call",
    "description": "Call an Ansible module by invoking it.",
    "properties": {
      "kwargs": {
        "type": "object",
        "description": "Keywords to pass to the module.",
        "required": [
          "module"
        ],
        "properties": {
          "module": {
            "type": "string",
            "title": "Module",
            "description": "Name of the module.",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$",
            "examples": [
              "ansible.builtin.command",
              "ansible.builtin.ping",
              "apt",
              "copy",
              "cron",
              "debug",
              "file",
              "group",
              "lineinfile",
              "package",
              "script",
              "service",
              "setup",
              "shell",
              "systemd",
              "template",
              "user",
              "yum"
            ]
          }
        },
        "additionalProperties": {
          "type": "string",
          "default": ""
        },
        "propertyNames": {
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "args": {
        "type": "array",
        "description": "Arguments to pass to the module.",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\.\\/\\-]+$"
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "additionalProperties": {
        "ui:label": false
      }
    },
    "args": {
      "items": {
        "ui:label": false
      }
    }
  }
}