{
  "json_schema": {
    "type": "object",
    "title": "ansible.targets",
    "description": "Return the inventory from an Ansible inventory_file.",
    "properties": {
      "kwargs": {
        "type": "object",
        "properties": {
          "inventory": {
            "type": "string",
            "title": "Inventory",
            "description": "The inventory file to read the inventory from. Default: `/etc/ansible/hosts`.",
            "pattern": "^\\/?([a-zA-Z0-9_-]+\\/)*[a-zA-Z0-9_-]+$",
            "examples": [
              "/etc/ansible/hosts",
              "/srv/ansible/inventories/production/hosts.yaml",
              "../development/hosts.ini",
              "my_custom_inventory",
              "/srv/ansible/inventories/staging/"
            ]
          },
          "yaml": {
            "type": "boolean",
            "title": "YAML output",
            "description": "Return the inventory as yaml output.",
            "default": false
          },
          "export": {
            "type": "boolean",
            "title": "Export format",
            "description": "Return inventory as export format.",
            "default": false
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "inventory": {
        "ui:enableMarkdownInDescription": true
      },
      "yaml": {
        "ui:widget": "select"
      },
      "export": {
        "ui:widget": "select"
      }
    }
  }
}