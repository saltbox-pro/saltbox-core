{
  "json_schema": {
    "title": "state.apply",
    "type": "object",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "mods"
        ],
        "properties": {
          "mods": {
            "type": "string",
            "pattern": "^\\w[\\w-]*(?:\\.[\\w-]+)*(?:,\\w[\\w-]*(?:\\.[\\w-]+)*)*$"
          },
          "test": {
            "type": "boolean",
            "default": false
          },
          "sync_mods": {
            "type": "string",
            "default": "all",
            "pattern": "^\\w[\\w-]*(?:,\\w[\\w-]*)*$"
          },
          "pillar": {
            "type": "object",
            "additionalProperties": {
              "default": ""
            },
            "propertyNames": {
              "pattern": "^(?:_+[a-zA-Z0-9]|[a-zA-Z])[\\w-]*$"
            }
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "ui:order": [
        "mods",
        "test",
        "sync_mods",
        "pillar",
        "*"
      ],
      "mods": {
        "ui:title": "Mods",
        "ui:description": "Names of SLS files to execute (separated by commas)"
      },
      "test": {
        "ui:title": "Test",
        "ui:description": "Run SLS files in test-only (dry-run) mode",
        "ui:widget": "select"
      },
      "sync_mods": {
        "ui:title": "Sync mods",
        "ui:description": [
          "If specified, the desired custom module types will be synced prior to running the SLS files (separated by commas). ",
          "This option is ignored when no SLS files are specified"
        ]
      },
      "pillar": {
        "ui:title": "Pillar",
        "ui:description": "Custom pillar values, passed as a dictionary of key-value pairs",
        "additionalProperties": {
          "ui:label": false,
          "ui:placeholder": "Enter value"
        }
      }
    }
  }
}
