{
  "json_schema": {
    "type": "object",
    "title": "ssh.set_known_host",
    "description": "Download SSH public key from remote host \"hostname\", optionally validate its fingerprint against \"fingerprint\" variable and save the record in the known_hosts file",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$"
          },
          "hostname": {
            "type": "string",
            "format": "hostname"
          },
          "fingerprint": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "default": 22,
            "minimum": 0,
            "maximum": 65535
          },
          "enc": {
            "type": "string",
            "default": "ssh-rsa",
            "oneOf": [
              {
                "title": "R",
                "const": "r"
              },
              {
                "title": "RSA",
                "const": "rsa"
              },
              {
                "title": "SSH-RSA",
                "const": "ssh-rsa"
              },
              {
                "title": "D",
                "const": "d"
              },
              {
                "title": "DSA",
                "const": "dsa"
              },
              {
                "title": "DSS",
                "const": "dss"
              },
              {
                "title": "SSH-DSS",
                "const": "ssh-dss"
              },
              {
                "title": "ED25519",
                "const": "ed25519"
              },
              {
                "title": "SSH-ED25519",
                "const": "ssh-ed25519"
              },
              {
                "title": "RSA-SHA2-512",
                "const": "rsa-sha2-512"
              },
              {
                "title": "RSA-SHA2-256",
                "const": "rsa-sha2-256"
              },
              {
                "title": "RSA-SHA2-512-CERT-V01@OPENSSH.COM",
                "const": "rsa-sha2-512-cert-v01@openssh.com"
              },
              {
                "title": "RSA-SHA2-256-CERT-V01@OPENSSH.COM",
                "const": "rsa-sha2-256-cert-v01@openssh.com"
              },
              {
                "title": "SSH-RSA-CERT-V01@OPENSSH.COM",
                "const": "ssh-rsa-cert-v01@openssh.com"
              },
              {
                "title": "ECDSA-SHA2-NISTP256-CERT-V01@OPENSSH.COM",
                "const": "ecdsa-sha2-nistp256-cert-v01@openssh.com"
              },
              {
                "title": "ECDSA-SHA2-NISTP384-CERT-V01@OPENSSH.COM",
                "const": "ecdsa-sha2-nistp384-cert-v01@openssh.com"
              },
              {
                "title": "ECDSA-SHA2-NISTP521-CERT-V01@OPENSSH.COM",
                "const": "ecdsa-sha2-nistp521-cert-v01@openssh.com"
              },
              {
                "title": "SK-ECDSA-SHA2-NISTP256@OPENSSH.COM",
                "const": "sk-ecdsa-sha2-nistp256@openssh.com"
              },
              {
                "title": "SK-ECDSA-SHA2-NISTP256-CERT-V01@OPENSSH.COM",
                "const": "sk-ecdsa-sha2-nistp256-cert-v01@openssh.com"
              },
              {
                "title": "SSH-ED25519-CERT-V01@OPENSSH.COM",
                "const": "ssh-ed25519-cert-v01@openssh.com"
              },
              {
                "title": "SK-SSH-ED25519@OPENSSH.COM",
                "const": "sk-ssh-ed25519@openssh.com"
              },
              {
                "title": "SK-SSH-ED25519-CERT-V01@OPENSSH.COM",
                "const": "sk-ssh-ed25519-cert-v01@openssh.com"
              }
            ]
          },
          "config": {
            "type": "string"
          },
          "hash_known_hosts": {
            "type": "boolean",
            "default": true
          },
          "timeout": {
            "type": "integer",
            "default": 5,
            "minimum": 0
          },
          "fingerprint_hash_type": {
            "type": "string",
            "default": "sha256",
            "oneOf": [
              {
                "title": "MD5",
                "const": "md5"
              },
              {
                "title": "SHA1",
                "const": "sha1"
              },
              {
                "title": "SHA224",
                "const": "sha224"
              },
              {
                "title": "SHA256",
                "const": "sha256"
              },
              {
                "title": "SHA384",
                "const": "sha384"
              },
              {
                "title": "SHA512",
                "const": "sha512"
              }
            ]
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "user": {
        "ui:title": "User",
        "ui:description": "The user who owns the ssh authorized keys file to modify"
      },
      "hostname": {
        "ui:title": "Hostname",
        "ui:description": "The name of the remote host (e.g. \"github.com\")"
      },
      "fingerprint": {
        "ui:title": "Fingerprint",
        "ui:description": "The fingerprint of the key which must be present in the known_hosts file (optional if key specified)"
      },
      "key": {
        "ui:title": "Key",
        "ui:description": "The public key which must be presented in the known_hosts file (optional if fingerprint specified)",
        "ui:widget": "textarea"
      },
      "port": {
        "ui:title": "SSH port",
        "ui:description": "Optional parameter, denoting the port of the remote host, which will be used in case, if the public key will be requested from it. By default the port 22 is used"
      },
      "enc": {
        "ui:title": "Encryption key type",
        "ui:description": "Defines what type of key is being used, can be ed25519, ecdsa, ssh-rsa, ssh-dss or any other type as of openssh server version 8.7",
        "ui:widget": "select"
      },
      "config": {
        "ui:title": "Path to the config file",
        "ui:description": "The location of the authorized keys file relative to the user's home directory, defaults to \".ssh/known_hosts\". If no user is specified, defaults to \"/etc/ssh/ssh_known_hosts\". If present, must be an absolute path when a user is not specified"
      },
      "hash_known_hosts": {
        "ui:title": "Hashing known hosts",
        "ui:description": "Hash all hostnames and addresses in the known hosts file",
        "ui:widget": "select"
      },
      "timeout": {
        "ui:title": "Timeout (sec)",
        "ui:description": "Set the timeout for connection attempts. If timeout seconds have elapsed since a connection was initiated to a host or since the last time anything was read from that host, then the connection is closed and the host in question considered unavailable"
      },
      "fingerprint_hash_type": {
        "ui:title": "Fingerprint hash type",
        "ui:description": "The fingerprint hash type that the public key fingerprints were originally hashed with. This defaults to sha256 if not specified",
        "ui:widget": "select"
      }
    }
  }
}
