                "const": "ssh-rsa"
              },
              {
                "title": "D",
                "const": "d"
              },
              {
                "title": "DSA",
                "const": "dsa"
              },
              {
                "title": "DSS",
                "const": "dss"
              },
              {
                "title": "SSH-DSS",
                "const": "ssh-dss"
              },
              {
