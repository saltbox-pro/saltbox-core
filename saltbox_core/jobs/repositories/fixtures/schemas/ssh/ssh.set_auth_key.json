        "required": [
          "user",
          "key"
        ],
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$"
          },
          "key": {
            "type": "string"
          },
          "enc": {
            "type": "string",
            "default": "ssh-rsa",
            "oneOf": [
              {
                "title": "R",
                "const": "r"
              },
              {
                "title": "RSA",
                "const": "rsa"
              },
              {
