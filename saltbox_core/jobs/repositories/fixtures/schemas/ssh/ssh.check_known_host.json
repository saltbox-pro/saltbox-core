{
  "json_schema": {
    "type": "object",
    "title": "ssh.check_known_host",
    "description": "Check the record in known_hosts file, either by its value or by fingerprint (it's enough to set up either key or fingerprint, you don't need to set up both)",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "hostname"
        ],
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[a-zA-Z][\\w\\.-]+$"
          },
          "hostname": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string"
          },
          "config": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "default": 22,
            "minimum": 0,
            "maximum": 65535
          },
          "fingerprint_hash_type": {
            "type": "string",
            "default": "sha256",
            "oneOf": [
              {
                "title": "MD5",
                "const": "md5"
              },
              {
                "title": "SHA1",
                "const": "sha1"
              },
              {
                "title": "SHA224",
                "const": "sha224"
              },
              {
                "title": "SHA256",
                "const": "sha256"
              },
              {
                "title": "SHA384",
                "const": "sha384"
              },
              {
                "title": "SHA512",
                "const": "sha512"
              }
            ]
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "user": {
        "ui:title": "User",
        "ui:description": ""
      },
      "hostname": {
        "ui:title": "Hostname",
        "ui:description": ""
      },
      "key": {
        "ui:title": "Key",
        "ui:description": "",
        "ui:widget": "textarea"
      },
      "fingerprint": {
        "ui:title": "Fingerprint",
        "ui:description": ""
      },
      "config": {
        "ui:title": "Path to the config file",
        "ui:description": ""
      },
      "port": {
        "ui:title": "SSH port",
        "ui:description": ""
      },
      "fingerprint_hash_type": {
        "ui:title": "Fingerprint hash type",
        "ui:description": "The fingerprint hash type that the public key fingerprints were originally hashed with. This defaults to sha256 if not specified",
        "ui:widget": "select"
      }
    }
  }
}
