{
  "json_schema": {
    "type": "object",
    "title": "disk.fstype",
    "description": "Return the filesystem name of the specified device",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "device"
        ],
        "properties": {
          "device": {
            "type": "string",
            "pattern": "^\\/dev\\/\\w+[0-9]$"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "device": {
        "ui:title": "Device",
        "ui:description": "The name of the device"
      }
    }
  }
}
