{
  "json_schema": {
    "type": "object",
    "title": "puppet.noop",
    "description": "Execute a puppet noop run and return a dict with the stderr, stdout, return code, etc. Usage is the same as for puppet.run.",
    "properties": {
      "args": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^([\\w.:-]+|\\/?([\\w-]+\\/)*[\\w-]+\\.pp)$",
          "examples": [
            "agent",
            "onetime",
            "no-daemonize",
            "apply",
            "/a/b/manifest.pp",
            "debug"
          ]
        }
      },
      "kwargs": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "string",
            "title": "Tags",
            "pattern": "^[a-zA-Z0-9]\\w*(::[a-zA-Z0-9]\\w*)*(,[a-zA-Z0-9]\\w*(::[a-zA-Z0-9]\\w*)*)*$",
            "examples": [
              "basefiles::edit,apache::server",
              "nginx::server"
            ]
          },
          "modulepath": {
            "type": "string",
            "title": "Module path",
            "pattern": "^(\\.?\\/[\\w-]+(\\/[\\w-]+)*|\\$\\w+)(:(\\.?\\/[\\w-]+(\\/[\\w-]+)*|\\$\\w+))*$",
            "examples": [
              "/a/b/modules",
              "/etc/puppet/modules:/opt/Shared_modules"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "pattern": "^\\w+$",
            "examples": [
              "production",
              "dev"
            ]
          },
          "server": {
            "type": "string",
            "title": "Server",
            "pattern": "^(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)$|^(?!\\d+(?:\\.\\d+){3}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
            "examples": [
              "puppet.example.com",
              "192.168.1.20"
            ]
          },
          "port": {
            "type": "integer",
            "title": "Port",
            "minimum": 0,
            "maximum": 65535
          },
          "certname": {
            "type": "string",
            "title": "Certificate name",
            "pattern": "^(?:(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(?:25[0-5]|2[0-4]\\d|1?\\d?\\d)$|^(?!\\d+(?:\\.\\d+){3}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)*[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
            "examples": [
              "k8s-master.Cluster-A.local",
              "Web-Prod-01",
              "192.168.20.5"
            ]
          }
        }
      }
    }
  },
  "ui_schema": {
    "args": {
      "items": {
        "ui:label": false
      }
    }
  }
}