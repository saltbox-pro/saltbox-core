{
  "json_schema": {
    "type": "object",
    "title": "puppet.fact",
    "description": "Run facter for a specific fact.",
    "properties": {
      "kwargs": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)*$"
          },
          "puppet": {
            "type": "boolean",
            "title": "Puppet",
            "default": false
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "puppet": {
        "ui:widget": "select"
      }
    }
  }
}