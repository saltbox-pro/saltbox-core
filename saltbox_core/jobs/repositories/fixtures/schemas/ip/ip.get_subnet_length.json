{
  "json_schema": {
    "type": "object",
    "title": "ip.get_subnet_length",
    "description": "Convenience function to convert the netmask to the CIDR subnet length",
    "properties": {
      "kwargs": {
        "type": "object",
        "title": "",
        "required": [
          "mask"
        ],
        "properties": {
          "mask": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4]\\d|1?\\d?\\d)\\.){3}(25[0-5]|2[0-4]\\d|1?\\d?\\d)$"
          }
        }
      }
    }
  },
  "ui_schema": {
    "kwargs": {
      "mask": {
        "ui:title": "Netmask",
        "ui:description": "e.g. 255.255.255.0"
      }
    }
  }
}
